# Pooled connection string from Neon (contains "-pooler" in the host) — used by the app at runtime.
DATABASE_URL=""

# Direct (non-pooled) connection string from Neon — used by `prisma migrate`.
DIRECT_URL=""

# Any long random string — Render's render.yaml auto-generates this for production.
JWT_SECRET=""

# Optional. Without it, new session bookings fall back to the free public
# Jitsi server. Get a free key from https://dashboard.daily.co/developers.
DAILY_API_KEY=""

# Optional. Without it, OTP/reset-password emails are only logged to the
# server console instead of actually being sent. Get a free key from
# https://resend.com/api-keys.
RESEND_API_KEY=""
